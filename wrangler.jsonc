{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-image-playground",
  "account_id": "7eafdf964fb0c0c6eff1a8796cfab5c3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-07",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IMAGE_JOBS",
        "class_name": "ImageJob"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ImageJob"]
    }
  ],
  "vars": {
    // 上游 OpenAI 兼容接口的基础地址，例如 https://api.example.com/v1
    "UPSTREAM_BASE_URL": "https://newapi-vps.ai-geek.tech/v1",
    // 上游鉴权头：bearer（默认）、apikey（X-Api-Key）、basic、none
    "UPSTREAM_AUTH_HEADER": "bearer",
    // 前端默认模型 ID，留空时使用应用内置默认值
    "DEFAULT_IMAGE_MODEL": "gpt-image-2.5-sunburst, gpt-image-2.5-flare",
    // Agnes Image 接口，例如 https://apihub.agnes-ai.com/v1
    "AGNES_BASE_URL": "https://agnes.20033999.xyz/v1",
    "AGNES_AUTH_HEADER": "bearer",
    "AGNES_IMAGE_MODEL": "agnes-image-2.5-flash",
    // 访问口令，留空表示对所有人开放
    "ACCESS_PASSWORD": "",
    // 单次上游请求的超时（毫秒）
    "PROXY_TIMEOUT_MS": "600000",
    // 后台任务失败后的最大尝试次数（1-5）
    "JOB_MAX_ATTEMPTS": "3"
  }
}
